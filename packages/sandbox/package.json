{
  "name": "@omnifile/sandbox",
  "version": "0.0.0",
  "description": "Runs omnifile plugins inside an isolated frame, so a malicious file cannot reach the page.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/YakovMallah/omnifile.git", "directory": "packages/sandbox" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": { "build": "rm -rf dist && tsup" },
  "dependencies": { "@omnifile/core": "workspace:^" }
}
