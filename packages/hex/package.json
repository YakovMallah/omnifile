{
  "name": "@omnifile/hex",
  "version": "0.0.0",
  "description": "omnifile plugin: hex view for any file, usable as a catch-all.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YakovMallah/omnifile.git",
    "directory": "packages/hex"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./frame": "./dist/frame.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsup"
  },
  "dependencies": {
    "@omnifile/core": "workspace:^"
  }
}
