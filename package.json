{
  "name": "omnifile-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --filter playground dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p playground/tsconfig.json && tsc --noEmit -p site/tsconfig.json",
    "site": "pnpm build && pnpm --filter site dev",
    "site:build": "pnpm build && pnpm --filter site build"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.0"
  }
}
